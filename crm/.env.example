# Alle Werte sind optional – ohne .env laeuft das CRM lokal out of the box.

# Adresse und Port des Webservers
CRM_HOST=127.0.0.1
CRM_PORT=4321

# Wo die SQLite-Datei liegt (Default: ./data/crm.db)
# CRM_DATA_DIR=/pfad/zu/daten
# CRM_DB_PATH=/pfad/zu/daten/crm.db

# API-Keys fuer Zugriff von aussen (kommagetrennt, beliebig lange Zufallsstrings).
# Ohne Key ist die API nur von localhost erreichbar.
# Erzeugen: node -e "console.log(crypto.randomUUID())"
# CRM_API_KEY=

# Key auch von localhost verlangen
# CRM_REQUIRE_KEY=1

# Fremde Web-Origins, die die API im Browser aufrufen duerfen (kommagetrennt, * moeglich)
# CRM_CORS_ORIGINS=https://meine-app.example
